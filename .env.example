# SignalOS Environment Variables

# Backend Environment
ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL in production/docker, SQLite in local dev)
DATABASE_URL=sqlite:///./signalos.db
POSTGRES_USER=signalos
POSTGRES_PASSWORD=signalos_secure_password
POSTGRES_DB=signalos_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Intelligence & LLM Configuration
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
